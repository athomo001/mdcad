{
  "name": "mdcat-extended",
  "private": true,
  "version": "1.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:exe": "tauri build --no-bundle",
    "build:dist": "tauri build -- --profile dist",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-binarios.ps1",
    "build:linux": "bash ./scripts/build-linux.sh",
    "preview": "vite preview",
    "screenshots": "node scripts/capture_screenshots.cjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
